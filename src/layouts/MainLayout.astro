---
// src/layouts/MainLayout.astro
import '@fontsource-variable/figtree';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import {
  GUIDES, LEGACY_ANCHORS, guideHref, guidePages, guideTitle, pageHref, withBase, type GuideSlug,
} from '../lib/guides';

interface Props {
  title: string;
  description?: string;
  current?: string;
  frontmatter?: {
    title: string;
    description: string;
    chapter?: number | string;
    current?: string;
    // A guide reference is a bare slug, or a slug plus the label this page
    // uses for it (guides refer to each other by varying short names).
    series?: { lead: string; guides: Array<GuideSlug | { slug: GuideSlug; label?: string }> };
    sections?: Array<{ id: string; title: string }>;
  };
}

const { title, description = "A practical field guide to system design basics.", frontmatter } = Astro.props;

const pageTitle = frontmatter?.title || title;
const pageDesc = frontmatter?.description || description;
const chapter = frontmatter?.chapter;
const current = frontmatter?.current || Astro.props.current;
const series = frontmatter?.series;
const sections = frontmatter?.sections;

// "A companion to <a>X</a>, <a>Y</a>, and <a>Z</a>."
const seriesLead = series?.lead;
const seriesLinks = (series?.guides ?? []).map((g) =>
  typeof g === 'string'
    ? { slug: g, title: guideTitle(g) }
    : { slug: g.slug, title: g.label ?? guideTitle(g.slug) }
);
const joiner = (i: number) => {
  if (i === 0) return '';
  return i === seriesLinks.length - 1 ? (seriesLinks.length > 2 ? ', and ' : ' and ') : ', ';
};

// Which guide, and which page of it, is this? Derived from the URL so guide
// pages need no extra frontmatter: /guides/<slug>/<page>/
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const match = Astro.url.pathname.slice(base.length).match(/^\/guides\/([^/]+)\/?([^/]*)/);
const guide = match && match[1] in GUIDES ? (match[1] as GuideSlug) : undefined;
const pages = guide ? guidePages(guide) : [];
const pageIdx = guide ? Math.max(0, pages.findIndex((p) => p.path === (match?.[2] ?? ''))) : -1;
const page = guide ? pages[pageIdx] : undefined;
const multiPage = pages.length > 1;

const slugs = Object.keys(GUIDES) as GuideSlug[];
const guideIdx = guide ? slugs.indexOf(guide) : -1;
const prev = !guide ? null
  : pageIdx > 0 ? { href: pageHref(guide, pages[pageIdx - 1].path), title: pages[pageIdx - 1].title }
  : guideIdx > 0 ? { href: guideHref(slugs[guideIdx - 1]), title: `Guide ${guideIdx}: ${GUIDES[slugs[guideIdx - 1]]}` }
  : null;
const next = !guide ? null
  : pageIdx < pages.length - 1 ? { href: pageHref(guide, pages[pageIdx + 1].path), title: pages[pageIdx + 1].title }
  : guideIdx < slugs.length - 1 ? { href: guideHref(slugs[guideIdx + 1]), title: `Guide ${guideIdx + 2}: ${GUIDES[slugs[guideIdx + 1]]}` }
  : null;

const docTitle = guide && multiPage && pageIdx > 0 ? `${pageTitle} — ${GUIDES[guide]}` : pageTitle;
const legacy = guide && pageIdx === 0 ? LEGACY_ANCHORS[guide] : undefined;
const legacyBase = guide ? guideHref(guide) : '';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{docTitle}</title>
  <meta name="description" content={pageDesc} />

  <style is:global>
    :root {
      --bg: #f1f3f6;
      --panel: #ffffff;
      --panel-2: #f4f6f9;
      --text: #1d2430;
      --muted: #5b6575;
      --accent: #1f5fd6;
      --accent-soft: #e8f0fd;
      --accent-2: #13795b;
      --warn: #8a5a00;
      --danger: #b42318;
      --good-soft: #e6f4ee;
      --bad-soft: #feeceb;
      --mid-soft: #fff4db;
      --border: #e1e5eb;
      --code-bg: #f4f6f9;
      --trace-bg: #1d2430;
      --trace-text: #dce3ec;
      --radius: 14px;
      --maxw: 780px;
      --font: "Figtree Variable", system-ui, -apple-system, "Segoe UI", sans-serif;
      --mono: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f151e;
        --panel: #151d29;
        --panel-2: #1b2534;
        --text: #dce3ec;
        --muted: #9aa6b8;
        --accent: #8ab4ff;
        --accent-soft: #1c2b45;
        --accent-2: #7fd1b9;
        --warn: #f2c46d;
        --danger: #ff9c94;
        --good-soft: #17322a;
        --bad-soft: #3a1e22;
        --mid-soft: #3a2f17;
        --border: #263243;
        --code-bg: #1b2534;
        --trace-bg: #0b1018;
        --trace-text: #c9d3df;
      }
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 76px; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font: 17px/1.7 var(--font);
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

    /* ---------- Page frames ---------- */

    /* Pages that aren't a guide (hub, complete edition): one centred column. */
    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 32px 20px 80px; }

    /* Guide pages: sidebar + a white lesson on the grey canvas. */
    .shell { display: grid; grid-template-columns: 290px minmax(0, 1fr); }
    .sidebar {
      position: sticky;
      top: 61px;
      height: calc(100vh - 61px);
      overflow: auto;
      padding: 24px 12px 40px 20px;
      background: var(--panel);
      border-right: 1px solid var(--border);
      font-size: 0.9rem;
    }
    .side-title { margin: 0 8px; font-weight: 700; font-size: 0.95rem; }
    .side-title a { color: var(--text); }
    .side-meta { margin: 2px 8px 16px; color: var(--muted); font-size: 0.8rem; }
    .sidebar ol { list-style: none; margin: 0; padding: 0; }
    .side-pages .item {
      display: grid;
      grid-template-columns: 18px 1fr;
      gap: 10px;
      align-items: start;
      padding: 7px 10px;
      border-radius: 8px;
      color: var(--text);
      line-height: 1.45;
    }
    .side-pages .item:hover { background: var(--panel-2); text-decoration: none; }
    .side-pages .item.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
    .tick {
      width: 18px;
      height: 18px;
      margin-top: 1px;
      border-radius: 50%;
      border: 2px solid var(--border);
      display: grid;
      place-items: center;
    }
    .item.active .tick { border-color: var(--accent); }
    .item.done .tick { background: var(--accent); border-color: var(--accent); }
    .item.done .tick::after { content: "✓"; color: var(--panel); font-size: 11px; font-weight: 700; line-height: 1; }
    .side-sections { margin: 2px 0 8px 27px !important; padding-left: 12px !important; border-left: 2px solid var(--border); }
    .side-sections a { display: block; padding: 4px 10px; color: var(--muted); font-size: 0.85rem; line-height: 1.4; }
    .side-sections a:hover { color: var(--accent); text-decoration: none; }

    .main { padding: 32px 32px 80px; min-width: 0; }
    .lesson {
      max-width: var(--maxw);
      margin: 0 auto;
      background: var(--panel);
      border-radius: 16px;
      padding: 40px 52px 48px;
    }
    .crumbs { font-size: 0.85rem; color: var(--muted); }
    .crumbs a { color: var(--muted); }
    .crumbs a:hover { color: var(--accent); }
    .crumbs .sep { margin: 0 6px; color: var(--border); }

    .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: var(--maxw); margin: 20px auto 0; }
    .pager a { display: block; padding: 16px 20px; background: var(--panel); border-radius: 14px; color: var(--text); font-weight: 600; line-height: 1.45; }
    .pager a:hover { text-decoration: none; box-shadow: inset 0 0 0 2px var(--accent-soft); }
    .pager small { display: block; color: var(--muted); font-weight: 400; font-size: 0.85rem; margin-bottom: 2px; }
    .pager .next { text-align: right; grid-column: 2; }

    /* ---------- Type ---------- */

    header.hero { margin: 12px 0 28px; }
    .kicker { color: var(--accent); font-weight: 600; font-size: 0.95rem; margin-bottom: 8px; }
    h1 { font-size: 2.6rem; line-height: 1.15; margin: 0 0 10px; letter-spacing: -0.02em; font-weight: 700; }
    .lede { color: var(--muted); font-size: 1.12rem; margin: 0; }
    .series { font-size: 0.85rem; color: var(--muted); margin: 10px 0 0; }

    h2 { font-size: 1.65rem; line-height: 1.25; margin: 56px 0 14px; letter-spacing: -0.01em; font-weight: 700; }
    h3 { font-size: 1.25rem; line-height: 1.3; margin: 36px 0 10px; font-weight: 700; }
    .sec:first-of-type > h2 { margin-top: 40px; }
    p { margin: 0 0 18px; }
    ul, ol { padding-left: 22px; }
    li { margin: 6px 0; }

    code {
      background: var(--panel-2);
      color: var(--text);
      padding: 1px 6px;
      border-radius: 5px;
      font-family: var(--mono);
      font-size: 0.85em;
    }
    pre {
      border-radius: 12px;
      padding: 16px 18px;
      overflow-x: auto;
      font-family: var(--mono);
      font-size: 0.85rem;
      line-height: 1.6;
      margin: 18px 0 24px;
    }
    pre code { background: none; padding: 0; font-size: 1em; color: inherit; }
    hr { border: none; border-top: 1px solid var(--border); margin: 40px 0; }
    .katex-display { margin: 10px 0 18px; padding: 14px 18px; background: var(--panel-2); border-radius: 10px; overflow-x: auto; overflow-y: hidden; }
    .katex { font-size: 1.08em; }

    /* ---------- Callouts ---------- */

    .note {
      border-left: 3px solid var(--accent);
      background: var(--panel-2);
      border-radius: 0 10px 10px 0;
      padding: 14px 18px;
      margin: 20px 0;
    }
    .note > :last-child { margin-bottom: 0; }
    .note.warn { border-left-color: var(--warn); }
    .note.key { border-left-color: var(--accent-2); }
    .note.war { border-left-color: var(--danger); }
    .note.wild { border-left-color: var(--accent-2); }
    .note .label { display: block; font-weight: 700; margin-bottom: 4px; color: var(--text); }
    .note.war .label { color: var(--danger); }
    .note.wild .label { color: var(--accent-2); }

    /* The incident and in-the-wild stories sit in a margin column on wide screens. */
    @media (min-width: 1320px) {
      .lesson { max-width: 1060px; padding-right: 340px; }
      .pager { max-width: 1060px; }
      .lesson .note.war, .lesson .note.wild {
        float: right;
        clear: right;
        width: 250px;
        margin: 4px -290px 28px 0;
        padding: 0;
        background: none;
        border: 0;
        font-size: 0.88rem;
        line-height: 1.6;
        color: var(--muted);
      }
      .lesson .note.war p, .lesson .note.wild p { margin: 0 0 8px; }
      .lesson .note.war a, .lesson .note.wild a { color: var(--muted); text-decoration: underline; }
    }

    .coldopen {
      border-left: 3px solid var(--danger);
      padding: 2px 0 2px 20px;
      margin: 8px 0 8px;
    }
    .coldopen .tag { display: block; color: var(--danger); font-weight: 700; margin-bottom: 6px; }
    .coldopen p { margin: 0 0 14px; }
    .coldopen p:last-child { margin-bottom: 0; }

    /* ---------- Structures ---------- */

    .stack { margin: 20px 0; }
    .layer {
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 16px;
      margin: 8px 0;
      position: relative;
    }
    .layer .idx {
      flex: 0 0 32px;
      height: 32px;
      border-radius: 8px;
      display: grid;
      place-items: center;
      font-weight: 700;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 0.95rem;
    }
    .layer .body { min-width: 0; }
    .layer .body h4 { margin: 0 0 2px; font-size: 1.02rem; }
    .layer .body p { margin: 0; font-size: 0.92rem; color: var(--muted); }
    .layer .body p + p { margin-top: 8px; }
    .layer .speed { margin-left: auto; font-size: 0.8rem; color: var(--muted); font-weight: 600; white-space: nowrap; }
    .arrow { text-align: center; color: var(--muted); font-size: 0.8rem; margin: -2px 0; }

    .table-scroll { overflow-x: auto; margin: 18px 0 24px; border: 1px solid var(--border); border-radius: 12px; }
    table { border-collapse: collapse; width: 100%; font-size: 0.92rem; min-width: 560px; }
    th, td { text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
    th { background: var(--panel-2); font-weight: 600; color: var(--muted); }
    tr:last-child td { border-bottom: none; }
    .num-table td:first-child { font-family: var(--mono); font-size: 0.85rem; color: var(--accent-2); white-space: nowrap; }

    .recap { background: var(--panel-2); border-radius: 12px; padding: 8px 22px 12px; margin: 18px 0; }
    .recap ul { padding-left: 18px; margin: 10px 0; }
    .recap li { margin: 8px 0; }

    .trace {
      background: var(--trace-bg);
      color: var(--trace-text);
      border-radius: 12px;
      padding: 18px 20px;
      margin: 18px 0 24px;
      font-family: var(--mono);
      font-size: 0.82rem;
      line-height: 1.75;
      overflow-x: auto;
      white-space: pre;
    }
    .trace b { color: #8fb8ff; font-weight: 600; }
    .trace .bad { color: #ff9c94; }
    .trace .good { color: #7dd3a8; }

    .pill { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; white-space: nowrap; }
    .pill.good { background: var(--good-soft); color: var(--accent-2); }
    .pill.bad { background: var(--bad-soft); color: var(--danger); }
    .pill.mid { background: var(--mid-soft); color: var(--warn); }

    .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 18px 0; }
    .card { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
    .card h4 { margin: 0 0 6px; font-size: 1rem; }
    .card p { margin: 0; font-size: 0.92rem; color: var(--muted); }
    .card > p + p { margin-top: 10px; }

    figure.figure { margin: 20px 0; padding: 16px; background: var(--panel-2); border-radius: var(--radius); }
    figure.figure figcaption { margin-top: 10px; font-size: 0.85rem; color: var(--muted); text-align: center; }

    .note.lab ol, .note.lab ul { padding-left: 20px; margin: 10px 0; }
    .note.lab li { margin: 10px 0; }
    .note.lab li > p { margin: 0 0 8px; }
    .note.lab pre { margin: 10px 0; }
    .lab-tip { margin: 12px 0 0; font-size: 0.88rem; color: var(--accent-2); }

    /* ---------- Hub ---------- */

    .guides { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 20px 0; }
    .g {
      display: block;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px;
      transition: border-color 0.15s;
      color: inherit;
    }
    .g:hover { border-color: var(--accent); text-decoration: none; }
    .g .num { font-size: 0.82rem; font-weight: 600; color: var(--muted); }
    .g h3 { margin: 6px 0 6px; font-size: 1.18rem; }
    .g p { margin: 0 0 10px; font-size: 0.92rem; color: var(--muted); }
    .g .tags { font-size: 0.8rem; color: var(--accent-2); }
    .g .meta { font-size: 0.8rem; color: var(--muted); margin-top: 8px; }
    .g .status { float: right; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: var(--good-soft); color: var(--accent-2); }
    .g .status.s2 { background: var(--accent-soft); color: var(--accent); }
    .g .status.s3 { background: var(--mid-soft); color: var(--warn); }
    .g .status.s4 { background: var(--bad-soft); color: var(--danger); }
    .g.wide { grid-column: 1 / -1; border-color: var(--accent); }
    .pillar { display: inline-block; font-size: 0.75rem; font-weight: 600; padding: 1px 8px; border-radius: 999px; background: var(--panel-2); color: var(--muted); margin-right: 6px; }
    .savehint { background: var(--panel-2); border: 1px dashed var(--border); border-radius: 10px; padding: 10px 14px; font-size: 0.88rem; color: var(--muted); margin: 18px 0; }
    .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 18px 0; }
    .path { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; }
    .path h4 { margin: 0 0 4px; font-size: 1rem; }
    .path p { margin: 0; font-size: 0.88rem; color: var(--muted); }
    .path .seq { display: block; margin-top: 8px; font-size: 0.85rem; color: var(--accent); font-weight: 600; }
    dl.gloss { margin: 14px 0; }
    dl.gloss dt { font-weight: 700; margin-top: 12px; }
    dl.gloss dd { margin: 2px 0 0; color: var(--muted); font-size: 0.95rem; }
    .journey { display: flex; flex-wrap: wrap; gap: 8px; align-items: stretch; margin: 22px 0; }
    .hop { flex: 1 1 130px; background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; position: relative; }
    .hop .n { font-size: 0.78rem; color: var(--accent); font-weight: 700; }
    .hop h4 { margin: 2px 0 4px; font-size: 0.98rem; }
    .hop p { margin: 0; font-size: 0.85rem; color: var(--muted); }
    .hop .ref { display: block; margin-top: 6px; font-size: 0.78rem; color: var(--accent-2); font-weight: 600; }

    /* ---------- Narrower screens ---------- */

    @media (max-width: 1100px) {
      .lesson { padding: 32px 36px 40px; }
    }
    @media (max-width: 900px) {
      .shell { grid-template-columns: 1fr; }
      .sidebar { display: none; }
      body.nav-open .sidebar {
        display: block;
        position: fixed;
        top: 61px;
        left: 0;
        right: 0;
        bottom: 0;
        height: auto;
        z-index: 90;
        border-right: 0;
      }
      .main { padding: 16px 12px 60px; }
      .lesson { padding: 24px 20px 32px; border-radius: 12px; }
      h1 { font-size: 2rem; }
    }
    @media (max-width: 600px) {
      .guides, .paths, .cards { grid-template-columns: 1fr; }
      .pager { grid-template-columns: 1fr; }
      .pager .next { grid-column: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation-delay: -1ms !important;
        animation-duration: 1ms !important;
        animation-iteration-count: 1 !important;
        background-attachment: initial !important;
        scroll-behavior: auto !important;
        transition-duration: 0s !important;
        transition-delay: 0s !important;
      }
    }
  </style>
</head>
<body>
  {current ? (
    <Header current={current} guide={guide} />
  ) : (
    <slot name="header" />
  )}

  {guide && page ? (
    <div class="shell">
      <nav class="sidebar" id="sidebar" aria-label={`${GUIDES[guide]} pages`}>
        <p class="side-title"><a href={guideHref(guide)}>{GUIDES[guide]}</a></p>
        <p class="side-meta" data-read-meta data-total={pages.length}>{pages.length === 1 ? 'One page' : `${pages.length} pages`}</p>
        <ol class="side-pages">
          {pages.map((p, i) => (
            <li>
              <a
                class:list={['item', { active: i === pageIdx }]}
                href={pageHref(guide, p.path)}
                data-read-key={pageHref(guide, p.path)}
                aria-current={i === pageIdx ? 'page' : undefined}
              >
                <span class="tick" aria-hidden="true"></span>
                <span>{p.title}</span>
              </a>
              {i === pageIdx && sections && sections.length > 0 && (
                <ol class="side-sections">
                  {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>

      <main class="main">
        <article class="lesson" id="top">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={withBase()}>Guides</a>
            <span class="sep">/</span>
            {multiPage ? <a href={guideHref(guide)}>{GUIDES[guide]}</a> : <span>{GUIDES[guide]}</span>}
            {multiPage && (<><span class="sep">/</span><span>{page.crumb}</span></>)}
          </nav>
          <header class="hero">
            <h1>{pageTitle}</h1>
            <p class="lede">{pageDesc}</p>
            {seriesLead && (
              <p class="series">
                {seriesLead}{' '}
                {seriesLinks.map((g, i) => (
                  <>
                    {joiner(i)}
                    <a href={guideHref(g.slug)}><em>{g.title}</em></a>
                  </>
                ))}.
              </p>
            )}
          </header>

          <slot />
        </article>

        <nav class="pager" aria-label="Previous and next">
          {prev && <a class="prev" href={prev.href}><small>Previous</small>{prev.title}</a>}
          {next && <a class="next" href={next.href}><small>Next</small>{next.title}</a>}
        </nav>
      </main>
    </div>
  ) : (
    <div class="wrap" id="top">
      {chapter && (
        <header class="hero">
          <h1>{pageTitle}</h1>
          <p class="lede">{pageDesc}</p>
        </header>
      )}
      <slot />
    </div>
  )}

  {legacy && (
    <script is:inline define:vars={{ legacy, legacyBase }}>
      // Old single-page anchors (#replicas, …) now live on other pages.
      const id = location.hash.slice(1);
      if (id && !document.getElementById(id) && legacy[id]) location.replace(legacyBase + legacy[id]);
    </script>
  )}

  <script is:inline>
    // Read ticks: a page counts as read once its previous/next links scroll into view.
    (function () {
      const KEY = 'sdg-read';
      let read;
      try { read = new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch (e) { read = new Set(); }
      const here = location.pathname.replace(/\/?$/, '/');
      const items = document.querySelectorAll('[data-read-key]');
      const meta = document.querySelector('[data-read-meta]');
      function paint() {
        let n = 0;
        items.forEach((a) => {
          const done = read.has(a.dataset.readKey);
          a.classList.toggle('done', done);
          if (done) n++;
        });
        if (meta && n > 0) {
          const total = Number(meta.dataset.total);
          meta.textContent = total === 1 ? 'Read' : `${n} of ${total} pages read`;
        }
      }
      paint();
      const end = document.querySelector('.pager');
      if (end && items.length && 'IntersectionObserver' in window) {
        new IntersectionObserver((entries, obs) => {
          if (entries.some((e) => e.isIntersecting)) {
            read.add(here);
            try { localStorage.setItem(KEY, JSON.stringify([...read])); } catch (e) {}
            paint();
            obs.disconnect();
          }
        }).observe(end);
      }
    })();

    // Remember scroll position per page.
    (function () {
      const key = 'sec-scroll-pos:' + location.pathname;
      const stored = localStorage.getItem(key);
      if (stored !== null && !location.hash) {
        setTimeout(() => window.scrollTo({ top: parseInt(stored, 10), behavior: 'auto' }), 120);
      }
      let t;
      window.addEventListener('scroll', () => {
        clearTimeout(t);
        t = setTimeout(() => localStorage.setItem(key, String(window.scrollY)), 150);
      }, { passive: true });
    })();
  </script>
</body>
</html>
