---
// src/components/Collapse.astro
// A numbered guide section: an anchor, an h2, and the content. The name is
// historical — sections used to be collapsible; they now read as plain sections.
// `open` is accepted and ignored so existing pages keep compiling.
interface Props {
  id: string;
  title: string;
  open?: boolean;
}
const { id, title } = Astro.props;
---
<section class="sec" id={id}>
  <h2>{title}</h2>
  <slot />
</section>
