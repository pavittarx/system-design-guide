---
// src/components/CacheRaceSimulator.astro
---

<div class="sim-box" id="aside-sim">
  <span class="label" style="color: var(--accent-2); margin-bottom: 6px;">🎮 Interactive Lab: Cache-Aside & Invalidation Race</span>
  <p style="font-size: 0.85rem; color: var(--muted); margin: 0 0 16px 0;">Run standard operations or simulate the thread race condition step-by-step to see how cache corruption happens in production.</p>
  <div class="sim-grid">
    <div class="sim-controls">
      <button class="sim-btn" id="btn-sim-read">Read Key (user:123)</button>
      <button class="sim-btn" id="btn-sim-write">Update DB & DEL (name = Grace)</button>
      <button class="sim-btn warn" id="btn-sim-race">⚡ Simulate OS Race Pause</button>
      <button class="sim-btn reset" id="btn-sim-reset">Reset States</button>
    </div>
        
    <div class="sim-nodes">
      <div class="sim-node" id="node-client">
        <div class="node-icon">💻</div>
        <div class="node-name">Client</div>
      </div>
      <div class="sim-flow-arrow" id="arrow-client-cache">──></div>
      <div class="sim-node" id="node-cache">
        <div class="node-icon">⚡</div>
        <div class="node-name">Cache (Redis)</div>
        <div class="node-val" id="val-cache">Empty</div>
      </div>
      <div class="sim-flow-arrow" id="arrow-cache-db">──></div>
      <div class="sim-node" id="node-db">
        <div class="node-icon">🗄️</div>
        <div class="node-name">Database</div>
        <div class="node-val" id="val-db">Ada</div>
      </div>
    </div>
  </div>
      
  <div class="sim-console" id="aside-console">
    <div class="console-line system">> Simulator ready. Click a button to begin.</div>
  </div>
</div>

<script>
  let dbValue = 'Ada';
  let cacheValue = null;
  
  function updateAsideUI() {
    const valDb = document.getElementById('val-db');
    const valCache = document.getElementById('val-cache');
    if (valDb) valDb.textContent = dbValue;
    if (valCache) valCache.textContent = cacheValue === null ? 'Empty' : cacheValue;
    
    const cacheNode = document.getElementById('node-cache');
    if (cacheNode && valCache) {
      if (cacheValue !== null && cacheValue !== dbValue) {
        cacheNode.style.borderColor = 'var(--danger)';
        valCache.style.color = 'var(--danger)';
      } else {
        cacheNode.style.borderColor = 'var(--border)';
        valCache.style.color = 'var(--accent-2)';
      }
    }
  }
  
  function writeAsideConsole(text, type = 'system') {
    const consoleEl = document.getElementById('aside-console');
    if (!consoleEl) return;
    const line = document.createElement('div');
    line.className = `console-line ${type}`;
    line.innerHTML = `> ${text}`;
    consoleEl.appendChild(line);
    consoleEl.scrollTop = consoleEl.scrollHeight;
  }
  
  function runAsideSim(action) {
    const clientNode = document.getElementById('node-client');
    const cacheNode = document.getElementById('node-cache');
    const dbNode = document.getElementById('node-db');
    const arrow1 = document.getElementById('arrow-client-cache');
    const arrow2 = document.getElementById('arrow-cache-db');
    
    if (clientNode) clientNode.className = 'sim-node';
    if (cacheNode) cacheNode.className = 'sim-node';
    if (dbNode) dbNode.className = 'sim-node';
    if (arrow1) arrow1.className = 'sim-flow-arrow';
    if (arrow2) arrow2.className = 'sim-flow-arrow';
    
    if (action === 'reset') {
      dbValue = 'Ada';
      cacheValue = null;
      const consoleEl = document.getElementById('aside-console');
      if (consoleEl) consoleEl.innerHTML = '<div class="console-line system">> Simulator reset.</div>';
      updateAsideUI();
      return;
    }
    
    if (action === 'read') {
      writeAsideConsole("Client sends read request for user:123", "client");
      if (clientNode) clientNode.classList.add('highlight');
      if (arrow1) arrow1.classList.add('active');
      
      setTimeout(() => {
        if (cacheValue !== null) {
          writeAsideConsole(`Cache Hit! Redis returned value: "${cacheValue}" (Latency: 0.5ms)`, "cache");
          if (cacheNode) cacheNode.classList.add('highlight-hit');
        } else {
          writeAsideConsole("Cache Miss! Redis returned None (Latency: 1ms)", "cache");
          if (cacheNode) cacheNode.classList.add('highlight-miss');
          if (arrow2) arrow2.classList.add('active');
          
          setTimeout(() => {
            writeAsideConsole(`Database Query: SELECT * FROM users WHERE id=123 (Latency: 15ms)`, "db");
            if (dbNode) dbNode.classList.add('highlight');
            writeAsideConsole(`Database returned value: "${dbValue}"`, "db");
            
            setTimeout(() => {
              cacheValue = dbValue;
              writeAsideConsole(`Write-Back: Redis key user:123 updated to "${cacheValue}"`, "cache");
              updateAsideUI();
            }, 600);
          }, 600);
        }
        updateAsideUI();
      }, 600);
    }
    
    if (action === 'write') {
      dbValue = 'Grace';
      writeAsideConsole(`Client updates user record to "Grace"`, "client");
      if (clientNode) clientNode.classList.add('highlight');
      if (arrow2) arrow2.classList.add('active');
      
      setTimeout(() => {
        writeAsideConsole(`Database Update: Set name = "Grace"`, "db");
        if (dbNode) dbNode.classList.add('highlight');
        if (arrow1) arrow1.classList.add('active');
        
        setTimeout(() => {
          cacheValue = null;
          writeAsideConsole(`Invalidate Key: DEL user:123 executed in Redis`, "cache");
          updateAsideUI();
        }, 600);
      }, 600);
    }
    
    if (action === 'race') {
      writeAsideConsole("⚡ Starting Invalidation Race Condition Simulation...", "danger");
      writeAsideConsole("Step 1: Reader misses cache, reads old value ('Ada') from DB.", "client");
      if (dbNode) dbNode.classList.add('highlight');
      
      setTimeout(() => {
        writeAsideConsole("⏳ Step 2: Reader suspended by OS during a Garbage Collection (GC) CPU pause!", "danger");
        if (cacheNode) cacheNode.classList.add('highlight-miss');
        
        setTimeout(() => {
          dbValue = 'Grace';
          cacheValue = null;
          writeAsideConsole("Step 3: Writer updates Database to 'Grace' and runs DEL user:123 (No-op).", "db");
          if (dbNode) dbNode.classList.add('highlight');
          updateAsideUI();
          
          setTimeout(() => {
            writeAsideConsole("Step 4: Reader wakes up and completes its write, setting cache to stale 'Ada'!", "danger");
            cacheValue = 'Ada';
            if (cacheNode) cacheNode.classList.add('highlight-miss');
            updateAsideUI();
            writeAsideConsole("🚨 Out of Sync! DB has 'Grace', but Cache is stale 'Ada' permanently! Only a TTL will fix this.", "danger");
          }, 1200);
        }, 1200);
      }, 1200);
    }
  }

  document.getElementById('btn-sim-read')?.addEventListener('click', () => runAsideSim('read'));
  document.getElementById('btn-sim-write')?.addEventListener('click', () => runAsideSim('write'));
  document.getElementById('btn-sim-race')?.addEventListener('click', () => runAsideSim('race'));
  document.getElementById('btn-sim-reset')?.addEventListener('click', () => runAsideSim('reset'));
</script>

<style>
  .sim-box {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    margin: 22px 0;
  }
  .sim-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 20px;
    margin-bottom: 16px;
  }
  @media (max-width: 600px) {
    .sim-grid { grid-template-columns: 1fr; }
  }
  .sim-controls {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sim-btn {
    background: var(--panel);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: left;
    transition: all 0.2s ease;
  }
  .sim-btn:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--panel));
  }
  .sim-btn.warn {
    border-color: var(--danger);
  }
  .sim-btn.warn:hover {
    background: color-mix(in srgb, var(--danger) 8%, var(--panel));
  }
  .sim-btn.reset {
    border-color: var(--muted);
  }
  .sim-nodes {
    display: flex;
    align-items: center;
    justify-content: space-around;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
    position: relative;
    overflow: hidden;
    min-height: 120px;
  }
  .sim-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel-2);
    width: 100px;
    text-align: center;
    transition: all 0.3s ease;
  }
  .sim-node.highlight {
    border-color: var(--accent);
    box-shadow: 0 0 10px rgba(91, 157, 255, 0.4);
  }
  .sim-node.highlight-hit {
    border-color: var(--accent-2);
    box-shadow: 0 0 10px rgba(126, 224, 192, 0.4);
  }
  .sim-node.highlight-miss {
    border-color: var(--danger);
    box-shadow: 0 0 10px rgba(255, 138, 138, 0.4);
  }
  .node-icon { font-size: 1.5rem; margin-bottom: 4px; }
  .node-name { font-size: 0.75rem; font-weight: 700; color: var(--muted); }
  .node-val {
    font-size: 0.72rem;
    font-family: monospace;
    background: var(--code-bg);
    padding: 2px 6px;
    border-radius: 4px;
    margin-top: 6px;
    color: var(--accent-2);
    max-width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sim-flow-arrow {
    font-family: monospace;
    font-size: 0.9rem;
    color: var(--border);
    transition: color 0.3s ease;
  }
  .sim-flow-arrow.active {
    color: var(--accent);
  }
  .sim-console {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    height: 120px;
    overflow-y: auto;
    font-family: monospace;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .console-line { margin: 4px 0; }
  .console-line.system { color: var(--muted); }
  .console-line.client { color: var(--accent); }
  .console-line.cache { color: var(--accent-2); }
  .console-line.db { color: var(--warn); }
  .console-line.danger { color: var(--danger); font-weight: bold; }
</style>
