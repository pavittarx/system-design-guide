---
// src/components/diagrams/DiagramCdnEdge2.astro
---

<svg viewBox="0 0 760 220" width="100%" height="auto" style="display: block; font-family: -apple-system, sans-serif;">
<text x="20" y="25" fill="var(--text)" font-size="13" font-weight="700">Origin Shielding Cache Consolidation</text>
<text x="20" y="55" fill="var(--danger)" font-size="11" font-weight="600">Without Shield (100 Edge PoPs hit Origin directly)</text>
<circle cx="60" cy="130" r="16" fill="var(--panel-2)" stroke="var(--border)" />
<text x="60" y="134" fill="var(--text)" font-size="9" text-anchor="middle">PoP 1</text>
<circle cx="120" cy="130" r="16" fill="var(--panel-2)" stroke="var(--border)" />
<text x="120" y="134" fill="var(--text)" font-size="9" text-anchor="middle">PoP 2</text>
<circle cx="180" cy="130" r="16" fill="var(--panel-2)" stroke="var(--border)" />
<text x="180" y="134" fill="var(--text)" font-size="9" text-anchor="middle">PoP 3</text>
<path d="M 60,114 L 120,70" stroke="var(--danger)" stroke-width="1" marker-end="url(#arrow-red)" />
<path d="M 120,114 L 120,70" stroke="var(--danger)" stroke-width="1" marker-end="url(#arrow-red)" />
<path d="M 180,114 L 120,70" stroke="var(--danger)" stroke-width="1" marker-end="url(#arrow-red)" />
<rect x="80" y="30" width="80" height="40" rx="4" fill="var(--panel-2)" stroke="var(--danger)" />
<text x="120" y="54" fill="var(--text)" font-size="10" text-anchor="middle">Origin</text>
<text x="400" y="55" fill="var(--accent-2)" font-size="11" font-weight="600">With Origin Shield (Consolidated Misses)</text>
<circle cx="440" cy="140" r="16" fill="var(--panel-2)" stroke="var(--border)" />
<text x="440" y="144" fill="var(--text)" font-size="9" text-anchor="middle">PoP 1</text>
<circle cx="500" cy="140" r="16" fill="var(--panel-2)" stroke="var(--border)" />
<text x="500" y="144" fill="var(--text)" font-size="9" text-anchor="middle">PoP 2</text>
<circle cx="560" cy="140" r="16" fill="var(--panel-2)" stroke="var(--border)" />
<text x="560" y="144" fill="var(--text)" font-size="9" text-anchor="middle">PoP 3</text>
<rect x="470" y="80" width="60" height="30" rx="4" fill="var(--panel-2)" stroke="var(--accent)" />
<text x="500" y="99" fill="var(--text)" font-size="9" text-anchor="middle">Shield</text>
<path d="M 440,124 L 480,110" stroke="var(--muted)" stroke-width="1" />
<path d="M 500,124 V 110" stroke="var(--muted)" stroke-width="1" />
<path d="M 560,124 L 520,110" stroke="var(--muted)" stroke-width="1" />
<rect x="460" y="20" width="80" height="40" rx="4" fill="var(--panel-2)" stroke="var(--accent-2)" stroke-width="1.5" />
<text x="500" y="44" fill="var(--text)" font-size="10" text-anchor="middle">Origin</text>
<path d="M 500,80 V 60" stroke="var(--accent-2)" stroke-width="2" marker-end="url(#arrow-green)" />
<text x="510" y="74" fill="var(--accent-2)" font-size="8">1 request</text>
<defs>
<marker id="arrow-red" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
<path d="M 0 1 L 10 5 L 0 9 z" fill="var(--danger)" />
</marker>
<marker id="arrow-green" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
<path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent-2)" />
</marker>
</defs>
</svg>
