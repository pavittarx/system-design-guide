---
// src/components/diagrams/DiagramConsistencyCap1.astro
---

<svg viewBox="0 0 760 260" width="100%" height="auto" style="display: block; font-family: -apple-system, sans-serif;">
<text x="20" y="25" fill="var(--text)" font-size="13" font-weight="700">The CAP Partition Choice (P is Mandatory)</text>
<circle cx="280" cy="140" r="75" fill="none" stroke="var(--accent)" stroke-width="2" />
<text x="230" y="100" fill="var(--accent)" font-size="12" font-weight="700">Consistency (C)</text>
<text x="230" y="115" fill="var(--muted)" font-size="9">All nodes see same data</text>
<circle cx="480" cy="140" r="75" fill="none" stroke="var(--accent-2)" stroke-width="2" />
<text x="530" y="100" fill="var(--accent-2)" font-size="12" font-weight="700">Availability (A)</text>
<text x="530" y="115" fill="var(--muted)" font-size="9">Non-error response</text>
<circle cx="380" cy="165" r="75" fill="none" stroke="var(--warn)" stroke-width="2" />
<text x="380" y="222" fill="var(--warn)" font-size="12" font-weight="700" text-anchor="middle">Partition Tolerance (P)</text>
<text x="380" y="234" fill="var(--muted)" font-size="9" text-anchor="middle">Survive network split</text>
<text x="310" y="155" fill="var(--text)" font-size="10" font-weight="700" text-anchor="middle">CP</text>
<text x="450" y="155" fill="var(--text)" font-size="10" font-weight="700" text-anchor="middle">AP</text>
<rect x="290" y="30" width="180" height="35" rx="6" fill="var(--panel-2)" stroke="var(--danger)" stroke-width="1.5" />
<text x="380" y="52" fill="var(--danger)" font-size="11" font-weight="700" text-anchor="middle">THE NETWORK SPLITS (P):</text>
<path d="M 290,48 L 220,90" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="3,3" />
<path d="M 470,48 L 540,90" fill="none" stroke="var(--accent-2)" stroke-width="1.5" stroke-dasharray="3,3" />
</svg>
