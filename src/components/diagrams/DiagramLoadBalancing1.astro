---
// src/components/diagrams/DiagramLoadBalancing1.astro
---

<svg viewBox="0 0 800 280" width="100%" height="auto" style="background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); margin: 20px 0; display: block;" xmlns="http://www.w3.org/2000/svg">
<style>
      .box-bg { fill: var(--panel-2); stroke: var(--border); stroke-width: 1.5; rx: 8; }
      .lbl-bold { font-family: -apple-system, sans-serif; font-size: 13px; font-weight: bold; fill: var(--text); }
      .lbl-norm { font-family: -apple-system, sans-serif; font-size: 12px; fill: var(--muted); }
      .lbl-small { font-family: -apple-system, sans-serif; font-size: 11px; fill: var(--muted); }
      .flow-line { stroke: var(--muted); stroke-width: 1.5; fill: none; }
      .flow-arrow { fill: var(--muted); }
    </style>
<rect width="100%" height="100%" fill="var(--panel)" rx="14" />

    
<g transform="translate(40, 30)">
<rect width="320" height="220" class="box-bg" />
<text x="160" y="25" class="lbl-bold" text-anchor="middle">Layer 4 (Transport Layer)</text>
      
      
<circle cx="60" cy="90" r="16" fill="var(--panel)" stroke="var(--border)" />
<text x="60" y="94" class="lbl-bold" text-anchor="middle">IP</text>
<text x="60" y="125" class="lbl-small" text-anchor="middle">TCP packets</text>

<path d="M 76 90 L 130 90" class="flow-line" marker-end="url(#arr)" />
      
<rect x="140" y="60" width="80" height="60" class="box-bg" style="stroke: var(--accent);" />
<text x="180" y="94" class="lbl-bold" text-anchor="middle" fill="var(--accent)">L4 LB</text>
<text x="180" y="145" class="lbl-small" text-anchor="middle">Fast forwarding</text>
<text x="180" y="160" class="lbl-small" text-anchor="middle">(No packet parsing)</text>

<path d="M 220 90 L 270 90" class="flow-line" marker-end="url(#arr)" />

<circle cx="290" cy="90" r="16" fill="var(--panel)" stroke="var(--border)" />
<text x="290" y="94" class="lbl-bold" text-anchor="middle">App</text>
</g>

    
<g transform="translate(440, 30)">
<rect width="320" height="220" class="box-bg" />
<text x="160" y="25" class="lbl-bold" text-anchor="middle">Layer 7 (Application Layer)</text>
      
      
<circle cx="50" cy="90" r="16" fill="var(--panel)" stroke="var(--border)" />
<text x="50" y="94" class="lbl-bold" text-anchor="middle">HTTP</text>
<text x="50" y="125" class="lbl-small" text-anchor="middle">GET /api/v1</text>

<path d="M 66 90 L 120 90" class="flow-line" marker-end="url(#arr)" />
      
<rect x="130" y="60" width="80" height="70" class="box-bg" style="stroke: var(--accent-2);" />
<text x="170" y="94" class="lbl-bold" text-anchor="middle" fill="var(--accent-2)">L7 LB</text>
<text x="170" y="112" class="lbl-small" text-anchor="middle">inspects</text>
<text x="170" y="125" class="lbl-small" text-anchor="middle">URL/headers</text>

<path d="M 210 80 Q 240 50 265 60" class="flow-line" marker-end="url(#arr)" />
<text x="240" y="45" class="lbl-small" text-anchor="middle">/api</text>
      
<circle cx="285" cy="70" r="16" fill="var(--panel)" stroke="var(--border)" />
<text x="285" y="74" class="lbl-bold" text-anchor="middle">API</text>

<path d="M 210 110 Q 240 140 265 130" class="flow-line" marker-end="url(#arr)" />
<text x="240" y="155" class="lbl-small" text-anchor="middle">/static</text>
      
<circle cx="285" cy="120" r="16" fill="var(--panel)" stroke="var(--border)" />
<text x="285" y="124" class="lbl-bold" text-anchor="middle">CDN</text>
</g>

<defs>
<marker id="arr" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
<path d="M 0 1.5 L 8 5 L 0 8.5 z" class="flow-arrow" />
</marker>
</defs>
</svg>
