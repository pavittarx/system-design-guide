---
// src/components/diagrams/DiagramMessageQueues2.astro
---

<svg viewBox="0 0 760 280" width="100%" height="auto" style="display: block; font-family: -apple-system, sans-serif;">
<text x="20" y="30" fill="var(--text)" font-size="14" font-weight="700">Log-Structured Partitioned Queue (Kafka-Style)</text>
<text x="20" y="50" fill="var(--muted)" font-size="11">Each partition is an append-only log. Consumers track progress via numeric offsets.</text>
<text x="20" y="100" fill="var(--text)" font-size="12" font-weight="600">Partition 0</text>
<rect x="110" y="80" width="50" height="35" rx="4" fill="var(--panel-2)" stroke="var(--border)" stroke-width="1.5" />
<text x="135" y="97" fill="var(--muted)" font-size="10" text-anchor="middle">Off 0</text>
<rect x="165" y="80" width="50" height="35" rx="4" fill="var(--panel-2)" stroke="var(--border)" stroke-width="1.5" />
<text x="190" y="97" fill="var(--muted)" font-size="10" text-anchor="middle">Off 1</text>
<rect x="220" y="80" width="50" height="35" rx="4" fill="var(--panel-2)" stroke="var(--border)" stroke-width="1.5" />
<text x="245" y="97" fill="var(--muted)" font-size="10" text-anchor="middle">Off 2</text>
<rect x="275" y="80" width="50" height="35" rx="4" fill="var(--panel-2)" stroke="var(--accent)" stroke-width="2" />
<text x="300" y="97" fill="var(--text)" font-size="10" font-weight="600" text-anchor="middle">Off 3</text>
<rect x="330" y="80" width="50" height="35" rx="4" fill="var(--panel-2)" stroke="var(--accent-2)" stroke-width="2" />
<text x="355" y="97" fill="var(--text)" font-size="10" font-weight="600" text-anchor="middle">Off 4</text>
<path d="M 300,50 L 300,70" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#arrow-blue)" />
<text x="300" y="42" fill="var(--accent)" font-size="10" font-weight="700" text-anchor="middle">Consumer A (offset 3)</text>
<path d="M 355,145 L 355,125" fill="none" stroke="var(--accent-2)" stroke-width="1.5" marker-end="url(#arrow-green)" />
<text x="355" y="158" fill="var(--accent-2)" font-size="10" font-weight="700" text-anchor="middle">Consumer B (offset 4)</text>
<text x="20" y="210" fill="var(--text)" font-size="12" font-weight="600">Partition 1</text>
<rect x="110" y="190" width="50" height="35" rx="4" fill="var(--panel-2)" stroke="var(--border)" stroke-width="1.5" />
<text x="135" y="207" fill="var(--muted)" font-size="10" text-anchor="middle">Off 0</text>
<rect x="165" y="190" width="50" height="35" rx="4" fill="var(--panel-2)" stroke="var(--accent)" stroke-width="2" />
<text x="190" y="207" fill="var(--text)" font-size="10" font-weight="600" text-anchor="middle">Off 1</text>
<path d="M 190,165 L 190,182" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#arrow-blue)" />
<circle cx="500" cy="98" r="6" fill="var(--accent)" />
<text x="515" y="101" fill="var(--text)" font-size="11">Active consumer pointer for Group A</text>
<circle cx="500" cy="208" r="6" fill="var(--accent-2)" />
<text x="515" y="211" fill="var(--text)" font-size="11">Independent read pointer for Group B</text>
<defs>
<marker id="arrow-blue" viewBox="0 0 10 10" refX="5" refY="8" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
<path d="M 0 0 L 5 10 L 10 0 z" fill="var(--accent)" />
</marker>
<marker id="arrow-green" viewBox="0 0 10 10" refX="5" refY="8" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
<path d="M 0 10 L 5 0 L 10 10 z" fill="var(--accent-2)" />
</marker>
</defs>
</svg>
