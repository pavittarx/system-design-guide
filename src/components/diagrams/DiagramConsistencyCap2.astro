---
// src/components/diagrams/DiagramConsistencyCap2.astro
---

<svg viewBox="0 0 760 260" width="100%" height="auto" style="display: block; font-family: -apple-system, sans-serif;">
<text x="20" y="25" fill="var(--danger)" font-size="12" font-weight="700">Without Session Pinning (Lagging Read)</text>
<rect x="20" y="50" width="70" height="40" rx="4" fill="var(--panel-2)" stroke="var(--border)" />
<text x="55" y="74" fill="var(--text)" font-size="10" text-anchor="middle">Client</text>
<path d="M 90,60 H 220" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#arrow)" />
<text x="155" y="52" fill="var(--accent)" font-size="8" text-anchor="middle">1. Write comment</text>
<rect x="230" y="50" width="80" height="40" rx="4" fill="var(--panel-2)" stroke="var(--accent)" />
<text x="270" y="74" fill="var(--text)" font-size="10" text-anchor="middle">Primary DB</text>
<path d="M 270,90 V 160" fill="none" stroke="var(--danger)" stroke-width="1.5" stroke-dasharray="4,4" />
<text x="280" y="130" fill="var(--danger)" font-size="8">Replica Lag (300ms)</text>
<rect x="230" y="170" width="80" height="40" rx="4" fill="var(--panel-2)" stroke="var(--border)" />
<text x="270" y="194" fill="var(--text)" font-size="10" text-anchor="middle">Replica DB</text>
<path d="M 90,80 L 220,185" fill="none" stroke="var(--muted)" stroke-width="1.5" marker-end="url(#arrow)" />
<text x="130" y="145" fill="var(--muted)" font-size="8" text-anchor="middle">2. Reload (reads replica)</text>
<text x="90" y="235" fill="var(--danger)" font-size="10" font-weight="600">Result: "Comment vanished!" user files ticket</text>
<line x1="375" y1="20" x2="375" y2="240" stroke="var(--border)" stroke-width="1" />
<text x="395" y="25" fill="var(--accent-2)" font-size="12" font-weight="700">With Session Sticky Routing (Linearized session)</text>
<rect x="395" y="50" width="70" height="40" rx="4" fill="var(--panel-2)" stroke="var(--border)" />
<text x="430" y="74" fill="var(--text)" font-size="10" text-anchor="middle">Client</text>
<path d="M 465,60 H 595" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#arrow)" />
<text x="530" y="52" fill="var(--accent)" font-size="8" text-anchor="middle">1. Write comment</text>
<rect x="605" y="50" width="80" height="40" rx="4" fill="var(--panel-2)" stroke="var(--accent)" />
<text x="645" y="74" fill="var(--text)" font-size="10" text-anchor="middle">Primary DB</text>
<path d="M 465,75 H 595" fill="none" stroke="var(--accent-2)" stroke-width="1.5" marker-end="url(#arrow)" />
<text x="530" y="90" fill="var(--accent-2)" font-size="8" text-anchor="middle">2. Reads routed to Primary (cookie set)</text>
<text x="465" y="235" fill="var(--accent-2)" font-size="10" font-weight="600">Result: User sees comment instantly</text>
<defs>
<marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
<path d="M 0 1 L 10 5 L 0 9 z" fill="var(--muted)" />
</marker>
</defs>
</svg>
