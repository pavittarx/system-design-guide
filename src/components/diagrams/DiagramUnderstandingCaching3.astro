---
// src/components/diagrams/DiagramUnderstandingCaching3.astro
---

<svg viewBox="0 0 800 360" width="100%" height="auto" style="background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); margin: 20px 0; display: block;" xmlns="http://www.w3.org/2000/svg">
<style>
      .sub-panel { fill: var(--panel-2); stroke: var(--border); stroke-width: 1; rx: 10; }
      .lbl-sec { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 14px; font-weight: bold; fill: var(--text); }
      .lbl-card { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 12px; fill: var(--text); }
      .lbl-card.bold { font-weight: bold; }
      .lbl-card.muted { fill: var(--muted); font-size: 11px; }
      .graph-line { stroke: var(--danger); stroke-width: 2.5; fill: none; }
      .graph-line.smooth { stroke: var(--accent-2); }
      .graph-axis { stroke: var(--border); stroke-width: 1.5; }
      .bubble { rx: 6; stroke-width: 1.5; }
      .bubble.req { fill: color-mix(in srgb, var(--accent) 10%, var(--panel)); stroke: var(--accent); }
      .bubble.db { fill: color-mix(in srgb, var(--warn) 10%, var(--panel)); stroke: var(--warn); }
    
  

</style>
<rect width="100%" height="100%" fill="var(--panel)" rx="14" />
<g transform="translate(15, 15)">
<rect width="370" height="330" class="sub-panel" />
<text x="185" y="25" class="lbl-sec" text-anchor="middle">Problem 1: Mass Expiry (Stampede)</text>
<g transform="translate(30, 50)">
<text x="0" y="20" class="lbl-card bold">Without Jitter (Synchronized Cliff)</text>
<line x1="30" y1="110" x2="160" y2="110" class="graph-axis" />
<line x1="30" y1="40" x2="30" y2="110" class="graph-axis" />
<path d="M 30 100 L 90 100 L 90 45 L 95 108 L 160 108" class="graph-line" />
<text x="90" y="38" class="lbl-card" fill="var(--danger)" font-weight="bold" font-size="10" text-anchor="middle">DB load spike!</text>
<text x="95" y="122" class="lbl-card muted" text-anchor="middle">TTL expired</text>
</g>
<g transform="translate(200, 50)">
<text x="0" y="20" class="lbl-card bold" fill="var(--accent-2)">With Jitter (Smoothed Expiries)</text>
<line x1="30" y1="110" x2="160" y2="110" class="graph-axis" />
<line x1="30" y1="40" x2="30" y2="110" class="graph-axis" />
<path d="M 30 100 L 70 100 Q 100 85 120 105 T 160 108" class="graph-line smooth" />
<text x="110" y="75" class="lbl-card" fill="var(--accent-2)" font-weight="bold" font-size="10" text-anchor="middle">Load distributed</text>
<text x="115" y="122" class="lbl-card muted" text-anchor="middle">Randomized TTLs</text>
</g>
<text x="185" y="200" class="lbl-card bold" text-anchor="middle">The Fix: TTL Jitter</text>
<text x="185" y="220" class="lbl-card muted" text-anchor="middle">Add a random offset (e.g., 3600s + rand(0, 360s))</text>
<text x="185" y="235" class="lbl-card muted" text-anchor="middle">so different keys written together do not expire together.</text>
<rect x="25" y="260" width="320" height="50" rx="8" fill="var(--panel)" stroke="var(--border)" />
<text x="185" y="290" font-family="monospace" font-size="12" fill="var(--accent-2)" text-anchor="middle">ttl = base_ttl + random(0, base_ttl / 10)</text>
</g>
<g transform="translate(415, 15)">
<rect width="370" height="330" class="sub-panel" />
<text x="185" y="25" class="lbl-sec" text-anchor="middle">Problem 2: Single Hot Key Expiry</text>
<g transform="translate(20, 50)">
<text x="80" y="20" class="lbl-card bold" text-anchor="middle">Without Coalescing</text>
<rect x="10" y="40" width="40" height="20" class="bubble req" />
<text x="30" y="54" class="lbl-card" font-size="10" text-anchor="middle">Req 1</text>
<rect x="10" y="65" width="40" height="20" class="bubble req" />
<text x="30" y="79" class="lbl-card" font-size="10" text-anchor="middle">Req 2</text>
<rect x="10" y="90" width="40" height="20" class="bubble req" />
<text x="30" y="104" class="lbl-card" font-size="10" text-anchor="middle">Req N</text>
<path d="M 50 50 L 110 75" class="graph-axis" style="stroke: var(--danger);" />
<path d="M 50 75 L 110 75" class="graph-axis" style="stroke: var(--danger);" />
<path d="M 50 100 L 110 75" class="graph-axis" style="stroke: var(--danger);" />
<rect x="110" y="55" width="40" height="40" class="bubble db" style="stroke: var(--danger);" />
<text x="130" y="78" class="lbl-card" fill="var(--danger)" font-weight="bold" font-size="10" text-anchor="middle">N queries</text>
</g>
<g transform="translate(200, 50)">
<text x="80" y="20" class="lbl-card bold" fill="var(--accent-2)" text-anchor="middle">With Single-Flight</text>
<rect x="10" y="40" width="40" height="20" class="bubble req" />
<text x="30" y="54" class="lbl-card" font-size="10" text-anchor="middle">Req 1</text>
<rect x="10" y="65" width="40" height="20" class="bubble req" />
<text x="30" y="79" class="lbl-card" font-size="10" text-anchor="middle">Req 2</text>
<rect x="10" y="90" width="40" height="20" class="bubble req" />
<text x="30" y="104" class="lbl-card" font-size="10" text-anchor="middle">Req N</text>
<circle cx="80" cy="75" r="12" style="fill: var(--panel); stroke: var(--accent); stroke-width: 2;" />
<text x="80" y="79" class="lbl-card" font-size="10" font-weight="bold" fill="var(--accent)" text-anchor="middle">SF</text>
<path d="M 50 50 L 70 68" class="graph-axis" />
<path d="M 50 75 L 68 75" class="graph-axis" />
<path d="M 50 100 L 70 82" class="graph-axis" />
<path d="M 92 75 L 110 75" class="graph-axis" style="stroke: var(--accent-2);" />
<rect x="110" y="55" width="40" height="40" class="bubble db" style="stroke: var(--accent-2);" />
<text x="130" y="78" class="lbl-card" fill="var(--accent-2)" font-weight="bold" font-size="10" text-anchor="middle">1 query</text>
</g>
<text x="185" y="200" class="lbl-card bold" text-anchor="middle">The Fix: Request Coalescing</text>
<text x="185" y="220" class="lbl-card muted" text-anchor="middle">First thread locks the key and loads from DB;</text>
<text x="185" y="235" class="lbl-card muted" text-anchor="middle">concurrent reads wait and share the single database result.</text>
<rect x="25" y="260" width="320" height="50" rx="8" fill="var(--panel)" stroke="var(--border)" />
<text x="185" y="290" font-family="monospace" font-size="12" fill="var(--accent-2)" text-anchor="middle">with single_flight(key): ...</text>
</g>
</svg>
