---
// src/components/diagrams/DiagramReliabilityToolkit1.astro
---

<svg viewBox="0 0 760 220" width="100%" height="auto" style="display: block; font-family: -apple-system, sans-serif;">
<text x="20" y="25" fill="var(--text)" font-size="12" font-weight="700">Naive Retries vs. Backoff &amp; Jitter</text>
<text x="20" y="55" fill="var(--danger)" font-size="11" font-weight="600">Naive Retries (Sync Storm)</text>
<line x1="40" y1="70" x2="40" y2="170" stroke="var(--border)" stroke-width="1.5" />
<line x1="40" y1="170" x2="320" y2="170" stroke="var(--border)" stroke-width="1.5" />
<text x="35" y="80" fill="var(--muted)" font-size="8" text-anchor="end">Load</text>
<text x="315" y="182" fill="var(--muted)" font-size="8" text-anchor="end">Time</text>
<path d="M 40,160 L 80,160 L 85,80 L 115,80 L 120,75 L 150,75 L 155,70 L 300,70" fill="none" stroke="var(--danger)" stroke-width="2.5" />
<text x="180" y="100" fill="var(--danger)" font-size="9" font-weight="600">Saturated (100% CPU)</text>
<text x="400" y="55" fill="var(--accent-2)" font-size="11" font-weight="600">Exponential Backoff + Jitter (Load Dispersion)</text>
<line x1="420" y1="70" x2="420" y2="170" stroke="var(--border)" stroke-width="1.5" />
<line x1="420" y1="170" x2="700" y2="170" stroke="var(--border)" stroke-width="1.5" />
<text x="415" y="80" fill="var(--muted)" font-size="8" text-anchor="end">Load</text>
<text x="695" y="182" fill="var(--muted)" font-size="8" text-anchor="end">Time</text>
<path d="M 420,160 L 460,160 L 465,95 L 490,120 L 520,135 L 560,145 L 610,152 L 680,155" fill="none" stroke="var(--accent-2)" stroke-width="2.5" />
<text x="540" y="110" fill="var(--accent-2)" font-size="9" font-weight="600">DB CPU decays to normal</text>
</svg>
