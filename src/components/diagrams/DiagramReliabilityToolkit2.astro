---
// src/components/diagrams/DiagramReliabilityToolkit2.astro
---

<svg viewBox="0 0 760 220" width="100%" height="auto" style="display: block; font-family: -apple-system, sans-serif;">
<rect x="20" y="60" width="160" height="70" rx="8" fill="var(--panel-2)" stroke="var(--accent-2)" stroke-width="2.5" />
<circle cx="45" cy="95" r="12" fill="var(--accent-2)" opacity="0.2" />
<circle cx="45" cy="95" r="6" fill="var(--accent-2)" />
<text x="75" y="99" fill="var(--text)" font-size="13" font-weight="700">CLOSED</text>
<text x="35" y="118" fill="var(--muted)" font-size="9">Traffic flows. Failures counted.</text>
<rect x="280" y="60" width="160" height="70" rx="8" fill="var(--panel-2)" stroke="var(--danger)" stroke-width="2.5" />
<circle cx="305" cy="95" r="12" fill="var(--danger)" opacity="0.2" />
<circle cx="305" cy="95" r="6" fill="var(--danger)" />
<text x="335" y="99" fill="var(--text)" font-size="13" font-weight="700">OPEN</text>
<text x="295" y="118" fill="var(--muted)" font-size="9">Fail fast. Return fallback.</text>
<rect x="540" y="60" width="160" height="70" rx="8" fill="var(--panel-2)" stroke="var(--warn)" stroke-width="2.5" />
<circle cx="565" cy="95" r="12" fill="var(--warn)" opacity="0.2" />
<circle cx="565" cy="95" r="6" fill="var(--warn)" />
<text x="595" y="99" fill="var(--text)" font-size="13" font-weight="700">HALF-OPEN</text>
<text x="555" y="118" fill="var(--muted)" font-size="9">Trickle probe requests.</text>
<path d="M 180,85 H 280" fill="none" stroke="var(--danger)" stroke-width="1.5" marker-end="url(#arrow-red)" />
<text x="230" y="77" fill="var(--danger)" font-size="9" text-anchor="middle" font-weight="600">Error threshold crossed</text>
<path d="M 440,95 H 540" fill="none" stroke="var(--muted)" stroke-width="1.5" marker-end="url(#arrow-grey)" />
<text x="490" y="87" fill="var(--muted)" font-size="9" text-anchor="middle">Cooldown expires</text>
<path d="M 540,110 C 440,150 280,150 280,130" fill="none" stroke="var(--danger)" stroke-width="1.5" stroke-dasharray="3,3" marker-end="url(#arrow-red)" />
<text x="410" y="152" fill="var(--danger)" font-size="9" text-anchor="middle">Probe fails</text>
<path d="M 620,130 C 620,190 100,190 100,130" fill="none" stroke="var(--accent-2)" stroke-width="1.5" marker-end="url(#arrow-green)" />
<text x="360" y="187" fill="var(--accent-2)" font-size="9" text-anchor="middle" font-weight="600">Probe succeeds</text>
<defs>
<marker id="arrow-red" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
<path d="M 0 1 L 10 5 L 0 9 z" fill="var(--danger)" />
</marker>
<marker id="arrow-grey" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
<path d="M 0 1 L 10 5 L 0 9 z" fill="var(--muted)" />
</marker>
<marker id="arrow-green" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
<path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent-2)" />
</marker>
</defs>
</svg>
