---
// src/components/diagrams/DiagramRealTimeSystems1.astro
---

<svg viewBox="0 0 760 220" width="100%" height="auto" style="display: block; font-family: -apple-system, sans-serif;">
<text x="20" y="25" fill="var(--text)" font-size="13" font-weight="700">SSE vs. WebSockets Architecture</text>
<text x="20" y="55" fill="var(--accent)" font-size="11" font-weight="600">Server-Sent Events (SSE)</text>
<rect x="20" y="70" width="320" height="120" rx="6" fill="var(--panel-2)" stroke="var(--border)" />
<text x="35" y="95" fill="var(--text)" font-size="10">HTTP/2 multiplexed, unidirectional push</text>
<text x="35" y="115" fill="var(--text)" font-size="10">Text only (JSON payloads)</text>
<text x="35" y="135" fill="var(--accent-2)" font-size="10">Auto-reconnect with Last-Event-ID: free</text>
<text x="35" y="165" fill="var(--muted)" font-size="9">Best for: Feeds, metrics, progress feeds</text>
<text x="400" y="55" fill="var(--accent-2)" font-size="11" font-weight="600">WebSockets</text>
<rect x="400" y="70" width="320" height="120" rx="6" fill="var(--panel-2)" stroke="var(--accent-2)" stroke-width="1.5" />
<text x="415" y="95" fill="var(--text)" font-size="10">Bidirectional full-duplex persistent TCP socket</text>
<text x="415" y="115" fill="var(--text)" font-size="10">Binary + Text support</text>
<text x="415" y="135" fill="var(--danger)" font-size="10">You manage handshakes, frames, retry backoff</text>
<text x="415" y="165" fill="var(--muted)" font-size="9">Best for: Chat, collaboration, gaming</text>
</svg>
