---
// src/pages/index.astro — the hub.
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import { GUIDES, guideHref, guidePages, pageHref, withBase, type GuideSlug } from '../lib/guides';

// Read time per guide, from the current text of all its pages (~230 words/min).
const raw = import.meta.glob('./guides/*/*.mdx', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const minutes = (slug: GuideSlug) => {
  let words = 0;
  for (const [path, text] of Object.entries(raw)) {
    if (!path.startsWith(`./guides/${slug}/`)) continue;
    const body = text.split('\n---\n').slice(1).join(' ');
    words += body.replace(/```[\s\S]*?```/g, ' ').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
  }
  return Math.max(5, Math.round(words / 230 / 5) * 5);
};

const slugs = Object.keys(GUIDES) as GuideSlug[];
const num = (s: GuideSlug) => slugs.indexOf(s) + 1;

const about: Record<GuideSlug, { theme: string; idea: string }> = {
  'understanding-caching': { theme: 'Speed', idea: "Don't redo expensive work: keep a copy close by, and know when it's gone stale." },
  'database-scaling': { theme: 'State', idea: 'One database has a ceiling. Tune it, take load off it, then split it, in that order.' },
  'load-balancing': { theme: 'Distribution', idea: 'One server is fragile. Spread traffic across many interchangeable ones.' },
  'message-queues': { theme: 'Async', idea: "Don't make users wait for work they don't need to see finish. Queue it, safely." },
  'reliability-toolkit': { theme: 'Resilience', idea: 'Everything fails. Timeouts, retries, breakers and bulkheads stop one failure spreading.' },
  'consistency-cap': { theme: 'Correctness', idea: 'When data lives in many places, decide how stale each piece is allowed to be.' },
  observability: { theme: 'Visibility', idea: "You can't fix what you can't see. Metrics, logs, traces, and alerts that mean something." },
  'api-gateways': { theme: 'Interface', idea: 'Your API is a promise. Design it to outlive the code, and count who calls it.' },
  'cdn-edge': { theme: 'Distance', idea: "You can't beat the speed of light, so keep a copy near every user." },
  'coordination-consensus': { theme: 'Agreement', idea: "Two machines can't tell slow from dead. Elect one leader and fence out the rest." },
  'real-time-systems': { theme: 'Push', idea: 'A live connection makes the server remember you. Plan for every client reconnecting at once.' },
  'design-the-checkout': { theme: 'Capstone', idea: 'Everything above, assembled into one real checkout from the traffic numbers up, then deliberately broken.' },
};

const groups: { title: string; lead: string; guides: GuideSlug[] }[] = [
  { title: 'Build and scale it', lead: 'The problems a growing product hits first, in roughly the order they arrive.', guides: slugs.slice(0, 6) },
  { title: 'Run it once it’s real', lead: 'What you need once it’s live and serving people: seeing inside it, guarding it, and keeping it fast far away.', guides: slugs.slice(6, 11) },
];

const paths: { title: string; why: string; seq: GuideSlug[] }[] = [
  { title: 'Interview in two weeks', why: 'Start with the capstone to see the shape of a good answer, then fill in the guides you fumble.', seq: ['design-the-checkout', 'database-scaling', 'understanding-caching', 'message-queues', 'consistency-cap'] },
  { title: 'Something is on fire', why: 'Find where it’s broken, name the failure, understand the cascade, survive the cold start.', seq: ['observability', 'reliability-toolkit', 'load-balancing', 'understanding-caching'] },
  { title: 'The product is growing', why: 'Nothing is broken yet. This is the order the problems usually turn up in.', seq: ['understanding-caching', 'database-scaling', 'load-balancing', 'message-queues', 'reliability-toolkit', 'consistency-cap', 'design-the-checkout'] },
  { title: 'You want the theory', why: 'You can build it and want to know why it works, from consistency down to coordination.', seq: ['consistency-cap', 'coordination-consensus', 'design-the-checkout', 'database-scaling'] },
  { title: 'You keep it running', why: 'It’s shipped and it’s yours: see inside it, then the edge, the gateway and the live connections.', seq: ['observability', 'cdn-edge', 'api-gateways', 'real-time-systems'] },
];

const stops: { name: string; what: string; guide: GuideSlug }[] = [
  { name: 'Edge', what: 'A copy near the user answers before the request crosses an ocean.', guide: 'cdn-edge' },
  { name: 'Load balancer', what: 'Picks a healthy server from many.', guide: 'load-balancing' },
  { name: 'API gateway', what: 'Checks who you are, counts your requests, routes you.', guide: 'api-gateways' },
  { name: 'Cache', what: 'Answers at once if it can, sparing everything behind it.', guide: 'understanding-caching' },
  { name: 'Database', what: 'The source of truth, replicated and split to keep up.', guide: 'database-scaling' },
  { name: 'Queue', what: 'Slow work that the user doesn’t need to wait for runs later.', guide: 'message-queues' },
  { name: 'Guardrails', what: 'Timeouts and breakers stop one failure spreading.', guide: 'reliability-toolkit' },
];

const numbers: [string, string, string][] = [
  ['~100 ns', 'Reading from your own process’s memory', 'A remote cache is about 1,000× slower. An in-process cache is a different tool.'],
  ['~0.5–2 ms', 'Redis or Memcached round trip, same zone', 'Fast enough to be free; ten of them in a loop is a bug.'],
  ['~1–10 ms', 'Indexed single-row database query', 'If yours is slower, the problem is the query, not the database.'],
  ['~0.5 ms', 'Round trip within one availability zone', 'Why “put it in the same zone” is the cheapest latency win there is.'],
  ['~1–2 ms', 'Round trip between zones in one region', 'A synchronous write across zones pays this every time. Usually worth it.'],
  ['~60–150 ms', 'Round trip between distant regions', 'Set by the speed of light in fibre. No code gets under it.'],
  ['99.9%', '8.8 hours of downtime a year', 'Roughly one bad afternoon a quarter.'],
  ['99.99%', '53 minutes a year', 'Less than one incident’s worth of debugging. This number is a staffing decision.'],
  ['0.999¹⁰ ≈ 99.0%', 'Ten hard dependencies at three nines each', 'Availability multiplies: you can’t beat the product of what you depend on.'],
  ['~1k–10k/s', 'Single-row writes one tuned database sustains', 'Most products never get here. Sharding talk below it is usually early.'],
  ['throughput × latency', 'Little’s Law: requests in flight at once', 'Turns “the site is slow” into a number. A timeout is a concurrency budget.'],
];

const words: [string, string][] = [
  ['Latency vs. throughput', 'Latency is how long one request takes; throughput is how many you finish per second. Improving one often costs the other, and batching is the classic example.'],
  ['p50, p99, p99.9', 'Percentiles of response time: p99 means 1% of requests are slower than this. Averages hide outages; percentiles don’t. At scale, p99 is somebody’s whole experience.'],
  ['Vertical vs. horizontal scaling', 'Vertical is a bigger box: simple, instant, and it runs out. Horizontal is more boxes: unlimited in principle, and it makes everything else here necessary.'],
  ['Stateless', 'A server that keeps nothing between requests it couldn’t rebuild. It makes servers interchangeable, which is what makes load balancing, autoscaling and rolling deploys possible.'],
  ['Idempotent', 'Doing it twice has the same effect as doing it once. It’s what makes retries safe.'],
  ['Backpressure', 'A system under strain telling its callers to slow down, instead of quietly queueing until it dies.'],
  ['Hot key', 'One key or partition getting far more traffic than the rest. Adding capacity doesn’t help, because routing sends it all to the same place.'],
  ['Eventual consistency', 'If writes stop, every copy converges on the same value eventually. It says nothing about how long that takes, which is the part that bites.'],
];

const projects: { title: string; concept: string; build: string; stack: string; guide: GuideSlug }[] = [
  { title: 'Cache stampede and coalescer', concept: 'Many identical cache misses at once, collapsed into one database query.', build: 'Write an HTTP server with a slow endpoint (a 500 ms database read). Load it until cache misses stampede the database, then add a coalescer, such as Go’s singleflight or a shared promise in Node, so concurrent identical reads share one query.', stack: 'k6, Docker, Redis, Go/Node/Python', guide: 'understanding-caching' },
  { title: 'Connection pooler benchmark', concept: 'Why 300 connections are slower than 16, and Little’s Law in practice.', build: 'Run Postgres in Docker and hit it from 300 concurrent workers. Watch it run out of connections and slow down. Put PgBouncer in front with a pool of 16 and measure latency and memory again.', stack: 'Postgres, PgBouncer, Docker Compose', guide: 'database-scaling' },
  { title: 'Consistent hashing from scratch', concept: 'Adding a server without reshuffling every key.', build: 'Implement a hash ring with virtual nodes. Spread 10,000 keys over 3 nodes, add a 4th, and check that only about 25% move, against about 75% with hash % N.', stack: 'Go, TypeScript or Python, no libraries', guide: 'load-balancing' },
  { title: 'Transactional outbox worker', concept: 'Publishing events reliably without a distributed transaction.', build: 'In one database transaction, insert an order and an outbox row. A worker publishes outbox rows to a broker and marks them sent on acknowledgement. Kill the broker mid-run and prove nothing is lost.', stack: 'Postgres, RabbitMQ or Kafka', guide: 'message-queues' },
  { title: 'Load shedding and concurrency limits', concept: 'Rejecting fast so accepted requests stay fast.', build: 'Load a CPU-heavy endpoint past capacity with k6 and watch p99 climb as requests queue. Add a limit on requests in flight that returns 429 straight away, and show the server stays healthy.', stack: 'Go, Rust or Node, k6', guide: 'reliability-toolkit' },
];

// Every guide page, in order, for the progress bars and "continue" link.
const allPages = Object.fromEntries(slugs.map((s) => [s, guidePages(s).map((p) => pageHref(s, p.path))]));
const order = slugs.flatMap((s) => allPages[s]);
const totalPages = order.length;
---

<MainLayout wide title="System Design Basics" description="Twelve plain-language guides to how real systems stay fast, correct and up as they grow: caching, databases, load balancing, queues, reliability, consistency and more.">
  <Header slot="header" tocHref="#guides" tocText="Browse guides" />

  <section class="intro">
    <h1>System Design Basics</h1>
    <p class="lede">Twelve guides on how real systems stay fast, correct and up as they grow. Each one starts with something breaking, explains why in plain words, and ends with questions that check you've got it.</p>
    <p class="for">Written for developers who have built and deployed a web app, and want to know what happens next.</p>
    <div class="actions">
      <a class="btn primary" href={guideHref(slugs[0])} data-continue>Start with Guide 1</a>
      <a class="btn" href="#paths">Pick a path</a>
      <span class="overall" data-overall data-total={totalPages}>{slugs.length} guides · {totalPages} pages</span>
    </div>
  </section>

  <section id="guides" class="block">
    {groups.map((g, gi) => (
      <div class="group">
        <h2>{g.title}</h2>
        <p class="group-lead">{g.lead}</p>
        <div class="cards">
          {g.guides.map((s) => (
            <a class="card" href={guideHref(s)}>
              <span class="card-top"><span class="no">{num(s)}</span><span class="theme">{about[s].theme}</span></span>
              <h3>{GUIDES[s]}</h3>
              <p>{about[s].idea}</p>
              <span class="card-meta">{allPages[s].length} pages · about {minutes(s)} min</span>
              <span class="bar" data-guide={s} aria-hidden="true"><span></span></span>
            </a>
          ))}
        </div>
      </div>
    ))}
    <a class="card capstone" href={guideHref('design-the-checkout')}>
      <span class="card-top"><span class="no">12</span><span class="theme">{about['design-the-checkout'].theme}</span></span>
      <h3>{GUIDES['design-the-checkout']}</h3>
      <p>{about['design-the-checkout'].idea} Read it last, or read it first and use it as a map of everything else.</p>
      <span class="card-meta">{allPages['design-the-checkout'].length} pages · about {minutes('design-the-checkout')} min</span>
      <span class="bar" data-guide="design-the-checkout" aria-hidden="true"><span></span></span>
    </a>
  </section>

  <section id="paths" class="block">
    <h2>Pick a path</h2>
    <p class="block-lead">Twelve guides is a lot to start with no plan. Each path is an order to read them in.</p>
    <div class="paths">
      {paths.map((p) => (
        <div class="path">
          <h3>{p.title}</h3>
          <p>{p.why}</p>
          <ol class="seq">
            {p.seq.map((s) => <li><a href={guideHref(s)} title={GUIDES[s]}>{num(s)}</a></li>)}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section id="journey" class="block">
    <h2>Follow one request</h2>
    <p class="block-lead">The guides aren't a random pile: they're the stops one click makes on its way through a well-built system. Each stop links to its guide.</p>
    <ol class="journey">
      {stops.map((st) => (
        <li>
          <a href={guideHref(st.guide)}>
            <span class="stop">{st.name}</span>
            <span class="what">{st.what}</span>
            <span class="which">Guide {num(st.guide)}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="journey-after">Underneath every stop is one question: how stale is this data allowed to be? That's <a href={guideHref('consistency-cap')}>Guide 6</a>. Watching the whole path is <a href={guideHref('observability')}>Guide 7</a>, machines agreeing on who's in charge is <a href={guideHref('coordination-consensus')}>Guide 10</a>, and the server pushing data back is <a href={guideHref('real-time-systems')}>Guide 11</a>.</p>
  </section>

  <section id="numbers" class="block">
    <h2>Numbers worth knowing</h2>
    <p class="block-lead">Most design arguments are settled by an order of magnitude, not a benchmark. Every figure here is approximate and a starting point, not a measurement of your system.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Roughly</th><th>What it is</th><th>Why it matters</th></tr></thead>
        <tbody>
          {numbers.map(([n, what, why]) => <tr><td class="n">{n}</td><td>{what}</td><td>{why}</td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section id="words" class="block">
    <h2>Words everyone uses and nobody defines</h2>
    <dl class="words">
      {words.map(([term, def]) => <div><dt>{term}</dt><dd>{def}</dd></div>)}
    </dl>
  </section>

  <section id="projects" class="block">
    <h2>Build it yourself</h2>
    <p class="block-lead">Reading is passive. Each of these fits in a weekend, runs on your laptop, and shows you understand real limits.</p>
    <div class="projects">
      {projects.map((p) => (
        <details class="project">
          <summary>
            <span class="p-title">{p.title}</span>
            <span class="p-concept">{p.concept}</span>
            <span class="p-stack">{p.stack} · goes with <a href={guideHref(p.guide)}>Guide {num(p.guide)}</a></span>
          </summary>
          <p>{p.build}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="use" class="block">
    <h2>How to use these guides</h2>
    <ul class="use">
      <li><strong>Climb only as high as you have to.</strong> Every guide ends in the same place: add complexity only when your numbers demand it. The simplest system that meets its targets wins.</li>
      <li><strong>Read one, then test yourself.</strong> Close the guide and answer its "Check your understanding" questions before looking. Getting one wrong is the moment it sticks. Come back a week later and try again.</li>
      <li><strong>Prefer one file?</strong> The <a href={withBase('system-design-basics-complete/')}>complete edition</a> puts the seven core guides on one page you can save, print or read offline.</li>
    </ul>
  </section>

  <p class="foot">System Design Basics: twelve guides, each with its sources at the end. Works on any screen, in light or dark.</p>

  <script is:inline define:vars={{ allPages, order }}>
    (function () {
      let read;
      try { read = new Set(JSON.parse(localStorage.getItem('sdg-read') || '[]')); } catch (e) { read = new Set(); }
      let total = 0;
      document.querySelectorAll('.bar[data-guide]').forEach((bar) => {
        const pages = allPages[bar.dataset.guide] || [];
        const done = pages.filter((p) => read.has(p)).length;
        total += done;
        if (done) {
          bar.classList.add('started');
          bar.firstElementChild.style.width = `${Math.round((done / pages.length) * 100)}%`;
          const meta = bar.previousElementSibling;
          if (meta) meta.textContent = `${done} of ${pages.length} pages read`;
        }
      });
      if (!total) return;
      const overall = document.querySelector('[data-overall]');
      if (overall) overall.textContent = `${total} of ${overall.dataset.total} pages read`;
      const next = order.find((p) => !read.has(p));
      const cont = document.querySelector('[data-continue]');
      if (cont && next) { cont.href = next; cont.textContent = 'Continue where you left off'; }
    })();
  </script>
</MainLayout>

<style>
  .intro { padding: 40px 0 16px; max-width: 760px; }
  .intro h1 { font-size: 3.2rem; line-height: 1.05; margin: 0 0 16px; letter-spacing: -0.03em; }
  .lede { font-size: 1.25rem; color: var(--text); margin: 0 0 10px; }
  .for { color: var(--muted); margin: 0 0 24px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .btn { display: inline-block; padding: 11px 18px; border-radius: 10px; font-weight: 600; border: 1px solid var(--border); background: var(--panel); color: var(--text); }
  .btn:hover { text-decoration: none; border-color: var(--accent); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--panel); }
  .overall { color: var(--muted); font-size: 0.92rem; margin-left: 4px; }

  .block { margin-top: 64px; }
  .block > h2, .group > h2 { margin: 0 0 6px; }
  .block-lead, .group-lead { color: var(--muted); margin: 0 0 20px; max-width: 720px; }
  .group + .group { margin-top: 40px; }

  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .card { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 20px 20px 22px; background: var(--panel); border: 1px solid var(--border); border-radius: 14px; color: var(--text); overflow: hidden; }
  .card:hover { text-decoration: none; border-color: var(--accent); }
  .card-top { display: flex; align-items: center; gap: 10px; }
  .no { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 0.9rem; }
  .theme { color: var(--muted); font-size: 0.85rem; font-weight: 600; }
  .card h3 { margin: 6px 0 0; font-size: 1.15rem; }
  .card p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.55; flex: 1; }
  .card-meta { margin-top: 8px; font-size: 0.82rem; color: var(--muted); }
  .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: transparent; }
  .bar.started { background: var(--panel-2); }
  .bar > span { display: block; height: 100%; width: 0; background: var(--accent); }
  .capstone { margin-top: 24px; border-color: var(--accent); }
  .capstone p { max-width: 720px; }

  .paths { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .path { padding: 18px 20px; background: var(--panel); border: 1px solid var(--border); border-radius: 14px; }
  .path h3 { margin: 0 0 6px; font-size: 1.05rem; }
  .path p { margin: 0 0 14px; color: var(--muted); font-size: 0.93rem; line-height: 1.55; }
  .seq { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .seq li { margin: 0; display: flex; align-items: center; gap: 6px; }
  .seq li + li::before { content: "→"; color: var(--muted); font-size: 0.85rem; }
  .seq a { display: grid; place-items: center; min-width: 30px; height: 30px; padding: 0 6px; border-radius: 8px; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 0.9rem; }
  .seq a:hover { text-decoration: none; background: var(--accent); color: var(--panel); }

  .journey { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; list-style: none; margin: 0; padding: 0; counter-reset: stop; }
  .journey li { margin: 0; counter-increment: stop; }
  .journey a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 14px; background: var(--panel); border: 1px solid var(--border); border-radius: 12px; color: var(--text); }
  .journey a:hover { text-decoration: none; border-color: var(--accent); }
  .stop { font-weight: 700; }
  .stop::before { content: counter(stop) ". "; color: var(--accent); }
  .what { font-size: 0.85rem; color: var(--muted); line-height: 1.45; flex: 1; }
  .which { font-size: 0.8rem; color: var(--accent); font-weight: 600; }
  .journey-after { margin: 20px 0 0; color: var(--muted); max-width: 820px; }

  .n { font-family: var(--mono); font-size: 0.85rem; white-space: nowrap; color: var(--accent-2); }

  .words { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 32px; margin: 0; }
  .words div { padding: 14px 0; border-top: 1px solid var(--border); }
  .words dt { font-weight: 700; margin-bottom: 4px; }
  .words dd { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.55; }

  .projects { display: grid; gap: 10px; }
  .project { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 0; }
  .project summary { cursor: pointer; list-style: none; display: grid; gap: 2px; padding: 14px 18px 14px 44px; position: relative; }
  .project summary::-webkit-details-marker { display: none; }
  .project summary::before { content: "+"; position: absolute; left: 18px; top: 13px; color: var(--accent); font-weight: 700; font-size: 1.1rem; }
  .project[open] summary::before { content: "−"; }
  .p-title { font-weight: 700; }
  .p-concept { color: var(--text); font-size: 0.95rem; }
  .p-stack { color: var(--muted); font-size: 0.85rem; }
  .project > p { margin: 0; padding: 0 18px 16px 44px; color: var(--muted); }

  .use { padding-left: 20px; max-width: 820px; }
  .use li { margin: 10px 0; }
  .foot { margin: 64px 0 0; padding-top: 20px; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.88rem; }

  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .journey { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .intro { padding-top: 16px; }
    .intro h1 { font-size: 2.3rem; }
    .lede { font-size: 1.1rem; }
    .cards, .words { grid-template-columns: 1fr; }
    .journey { grid-template-columns: 1fr 1fr; }
    .block { margin-top: 48px; }
  }
</style>
